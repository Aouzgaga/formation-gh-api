@inject FormationGhApi.Web.Services.PasswordService Password

@if (!pret)
{
    <p class="auth-status" role="status">Chargement…</p>
}
else if (!Password.EstAuthentifie)
{
    <main class="auth-page">
        <section class="auth-card">
            <p class="eyebrow">ESPACE SÉCURISÉ</p>
            <h1>@(Password.EstConfigure ? "Bienvenue" : "Protégez votre espace")</h1>
            <p class="muted">
                @(Password.EstConfigure
                    ? "Saisissez votre mot de passe pour accéder à la gestion des congés."
                    : "Créez un mot de passe pour protéger les données de votre équipe.")
            </p>
            <form @onsubmit="SoumettreAsync" @onsubmit:preventDefault>
                <label>
                    Mot de passe
                    <input type="password" @bind="motDePasse" autocomplete="@(Password.EstConfigure ? "current-password" : "new-password")" autofocus />
                </label>
                @if (!Password.EstConfigure)
                {
                    <label>
                        Confirmer le mot de passe
                        <input type="password" @bind="confirmation" autocomplete="new-password" />
                    </label>
                }
                <button class="primary-button" type="submit">
                    @(Password.EstConfigure ? "Se connecter" : "Protéger l’application")
                </button>
            </form>
            @if (!string.IsNullOrEmpty(erreur))
            {
                <p class="error-message" role="alert">@erreur</p>
            }
        </section>
    </main>
}
else
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string motDePasse = string.Empty;
    private string confirmation = string.Empty;
    private string? erreur;
    private bool pret;

    protected override async Task OnInitializedAsync()
    {
        await Password.InitialiserAsync();
        pret = true;
    }

    private async Task SoumettreAsync()
    {
        erreur = null;

        if (!Password.EstConfigure)
        {
            if (motDePasse.Length < 8)
            {
                erreur = "Le mot de passe doit contenir au moins 8 caractères.";
                return;
            }

            if (motDePasse != confirmation)
            {
                erreur = "Les mots de passe ne correspondent pas.";
                return;
            }

            await Password.ConfigurerAsync(motDePasse);
            return;
        }

        if (!await Password.AuthentifierAsync(motDePasse))
        {
            erreur = "Mot de passe incorrect.";
            motDePasse = string.Empty;
        }
    }
}
